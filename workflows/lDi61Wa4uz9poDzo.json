      "parameters": {
        "functionCode": "let results = [];\n\n// Lấy item gốc từ node Form Submission (dù node code nằm bất kỳ đâu)\nconst formItem = $items(\"On form submission\", 0)[0];\n\nif (!formItem.binary) {\n    throw new Error(\"Form item does not contain binary data\");\n}\n\nconst binaries = formItem.binary;\n\nfor (const key of Object.keys(binaries)) {\n    results.push({\n        json: {\n            fileName: binaries[key].fileName,\n            mimeType: binaries[key].mimeType,\n        },\n        binary: {\n            [key]: binaries[key],\n        }\n    });\n}\n\nreturn results;\n"
      },
