    {
      "parameters": {
        "jsCode": "function cleanPromptForBanana(str) {\n  if (!str) return \"\";\n\n  return str\n    .normalize(\"NFC\") // Chuẩn hóa Unicode (giữ tiếng Việt)\n\n    // Smart quotes → ASCII\n    .replace(/[“”]/g, '\"')\n    .replace(/[‘’]/g, \"'\")\n\n    // En dash / Em dash → \"-\"\n    .replace(/–|—/g, \"-\")\n\n    // Xóa ký tự control ẩn (KHÔNG xóa Unicode tiếng Việt)\n    .replace(/[\\u0000-\\u001F\\u007F]/g, \"\")\n\n    // Chuẩn hóa khoảng trắng\n    .replace(/\\s+/g, \" \")\n\n    .trim();\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const prompt = items[i].json[\"Prompt image\"] || \"\";\n  items[i].json.cleanedPrompt = cleanPromptForBanana(prompt);\n}\n\nreturn items;"
      },
